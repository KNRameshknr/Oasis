# Voice Assistant Environment Variables
# Copy this file to .env and fill in your actual API keys

# OpenWeather API for weather updates
OPENWEATHER_API_KEY=your_openweather_api_key_here

# OpenAI API for advanced natural language processing
OPENAI_API_KEY=your_openai_api_key_here

# Wolfram Alpha API for knowledge queries
WOLFRAM_ALPHA_API_KEY=your_wolfram_alpha_api_key_here

# Gmail credentials for email functionality
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Smart Home Integration (optional)
PHILIPS_HUE_BRIDGE_IP=192.168.1.100
PHILIPS_HUE_USERNAME=your_hue_username

# Advanced Features
ENABLE_CLOUD_SYNC=false
ENABLE_VOICE_TRAINING=false